# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Database — leave empty for unit tests; set for local PostGIS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spain_properties
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/spain_properties

# Supabase (required in production; optional for local fake providers)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=authorized-media

# Auth / OTP — fake adapters for local and CI
OTP_PROVIDER=fake
EMAIL_PROVIDER=fake
SMS_PROVIDER=fake
FAKE_SESSION_SECRET=dev-only-fake-session-secret
# ALLOW_HEADER_AUTH=true  # local escape hatch only; forbidden in production
# APP_ORIGIN=https://app.example.com  # only needed when a proxy hides the public origin from Host
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS_PER_IDENTITY_PER_HOUR=5
OTP_MAX_ATTEMPTS_PER_IP_PER_HOUR=20

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./.data/uploads

# Maps (Phase 2+)
NEXT_PUBLIC_MAP_STYLE_URL=
GEOCODER_PROVIDER=fake

# AI (Phase 5+)
AI_PROVIDER=fake
AI_DAILY_TOKEN_BUDGET=100000

# Jobs — Phase 1 uses inline (no external job SaaS credentials)
JOBS_PROVIDER=inline

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Feature flags — keep channel upgrades off
FEATURE_WHATSAPP=false
FEATURE_WEB_VOICE=false
FEATURE_PHONE_VOICE=false
FEATURE_CALL_RECORDING=false
