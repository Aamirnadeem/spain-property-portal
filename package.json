{
  "name": "spain-properties",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@spain/web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @spain/database generate",
    "db:migrate": "pnpm --filter @spain/database migrate",
    "db:seed": "pnpm --filter @spain/database seed",
    "db:import-legacy": "pnpm --filter @spain/ingestion import:legacy",
    "db:import-partner-fixture": "pnpm --filter @spain/ingestion import:partner-fixture",
    "test:db": "pnpm --filter @spain/database test:db",
    "test:e2e": "pnpm --filter @spain/web test:e2e",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
